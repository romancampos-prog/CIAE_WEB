        },
        "reporte": {
            "numerador": {
                "fuente": "xlsxWeb",
                "hoja": "rep_infeccionmicroorga",
                "modoExtraccion": "FILTRO_CONTEO",
                "encabezado": 5,
                "filtroColumna": {
                    "R": {
                        "filtro": "NO",
                        "nombreColumna": "Infección importada de otro hospital"
                    },
                    "AF": {
                        "filtro": "CONFIRMADA",
                        "nombreColumna": "Clasificación de la infección"
                    }
                }
            },
            "denominador": {
                "fuente": "xlsxWeb",
                "hoja": "PARTE_2_crosstab",
                "modoExtraccion": "FILTRO_UNIDAD_VALOR",
                "encabezado": 1,
                "columnaUnidad": {
                    "B": {
                        "filtro": "UNIDADES_IAAS",
                        "nombreColumna": "Denominacion Unidad"
                    }
                },
                "filtroColumna": {
                    "F": {
                        "filtro": "Total Unidad",
                        "nombreColumna": "Division"
                    }
                },
                "tomarValor": {
                    "Z": "Dias Paciente"
                }
            },
            "operacion": {
                "numerador": "(numerador)",
                "denominador": "(denominador)",
                "resultado": "round((numerador / denominador) * 1000, 2)"
            }
        },
        "semaforo": {
